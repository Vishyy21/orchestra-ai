# ORCHESTRA AI — Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173

# Single-Operator Authentication & Session Security
AUTH_ENABLED=false
AUTH_PASSWORD=
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=12
AUTH_COOKIE_NAME=orchestra_session

# Database & Persistence
DATABASE_URL=sqlite:///./orchestra.db

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Web Search Configuration (Optional — mock search used if empty)
TAVILY_API_KEY=

# LangSmith Observability & Tracing (Optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orchestra-ai
